# Public origin of the deployed site. Used for metadataBase, canonical URLs,
# sitemap.xml and robots.txt. No trailing slash.
#
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production: set this in Vercel → Project → Settings → Environment Variables
# (or here for `vercel env pull`), e.g. https://portfolio-<hash>.vercel.app
